{
  "name": "apexify.js",
  "version": "6.0.0",
  "description": "Advanced server-side canvas rendering, image processing, charts, GIF/video workflows, procedural audio, scenes and templates for Node.js.",
  "author": "zenith-79",
  "license": "MIT",
  "homepage": "https://apexifyjs.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/EIAS79/Apexify.js.git"
  },
  "bugs": {
    "url": "https://github.com/EIAS79/Apexify.js/issues"
  },
  "type": "module",
  "engines": {
    "node": "22.x || 24.x || 26.x",
    "npm": ">=10"
  },
  "packageManager": "npm@11.19.1",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/declarations/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/declarations/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    },
    "./types": {
      "types": "./dist/declarations/types/index.d.ts",
      "import": "./dist/esm/types/index.js",
      "require": "./dist/cjs/types/index.cjs",
      "default": "./dist/esm/types/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:js": "node scripts/build-package.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "npm run clean && npm run typecheck && npm run build:js && npm run build:types && node scripts/verify-dist.cjs",
    "test:security": "node scripts/phase1-security-scan.cjs && node tests/security-phase1.cjs",
    "test": "npm run test:security",
    "verify:package": "npm run build && node scripts/verify-packed-package.cjs",
    "verify:release": "npm run build && npm test && node scripts/verify-packed-package.cjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify:release"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "Apex-Banner.png"
  ],
  "keywords": [
    "canvas",
    "typescript",
    "image-processing",
    "image-generation",
    "server-side-rendering",
    "@napi-rs/canvas",
    "sharp",
    "charts",
    "gif",
    "video-processing",
    "ffmpeg",
    "procedural-audio",
    "scene-rendering",
    "templates",
    "graphics",
    "nodejs"
  ],
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@skyra/gifenc": "^1.0.1",
    "axios": "^1.15.0",
    "fs-extra": "^11.3.1",
    "imgur": "^2.5.0",
    "jimp": "^1.6.0",
    "jszip": "^3.10.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
