# Apexify.js optional external-service configuration.
# Never commit real credentials.
IMGUR_CLIENT_ID=your_imgur_client_id
IMGUR_CLIENT_SECRET=your_imgur_client_secret
IMGUR_ACCESS_TOKEN=your_imgur_access_token
IMGUR_REFRESH_TOKEN=your_imgur_refresh_token

# Optional FFmpeg/ffprobe executable overrides.
# APEXIFY_FFMPEG_PATH=/absolute/path/to/ffmpeg
# APEXIFY_FFPROBE_PATH=/absolute/path/to/ffprobe

# Optional isolated workspace parent. Defaults to the operating-system temp directory.
# APEXIFY_TEMP_DIR=/path/to/private/temp-parent

# Debug only. When true, Apexify retains operation workspaces for inspection.
# Never enable in normal production workloads.
# APEXIFY_RETAIN_TEMP_FILES=false
